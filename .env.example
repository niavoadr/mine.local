DB_HOST=localhost
DB_PORT=[port_de_la_base_de_données]
DB_USER=[nom_d'utilisateur]
DB_PASS=[mot_de_passe]
DB_NAME=[nom_de_la_base_de_données]
RADIUS_MAC_SECRET=[mot secret pour le protocole RADIUS]

# Déconnexion automatique du portail captif quand une MAC est supprimée.
# Mettre true uniquement après avoir configuré l'accès SSH par clé depuis le serveur web.
CAPTIVE_PORTAL_SSH_ENABLED=false
CAPTIVE_PORTAL_SSH_HOST=192.0.2.1
CAPTIVE_PORTAL_SSH_USER=admin
CAPTIVE_PORTAL_SSH_PORT=22
CAPTIVE_PORTAL_SSH_KEY=/var/www/.ssh/captive_portal_ed25519
CAPTIVE_PORTAL_SSH_TIMEOUT=10
CAPTIVE_PORTAL_SSH_STRICT_HOST_KEY_CHECKING=accept-new

# Commande exécutée sur le portail captif.
# Placeholders disponibles: {mac}, {mac_upper}, {mac_compact}, {mac_compact_upper}
# Exemple générique:
CAPTIVE_PORTAL_DISCONNECT_COMMAND="sudo /usr/local/bin/disconnect-captive-client --mac {mac}"
