# =========================================================
# Fichier d'exemple de configuration (.env.example)
# Copiez ce fichier en '.env' et remplacez par vos vraies valeurs
# =========================================================

# Base de données principale (Utilisateurs, Rôles, Départements)
DB_HOST=localhost
DB_PORT=3306
DB_USER=rosa
DB_PASS=12345
DB_NAME=radius_ministere_mines

# Base de données RADIUS (Appareils, Historique de connexion radacct/radcheck)
RADIUS_DB_HOST=localhost
RADIUS_DB_PORT=3306
RADIUS_DB_USER=rosa
RADIUS_DB_PASS=12345
RADIUS_DB_NAME=radius

# Base de données pour les tests de diagnostic (test_radius.php)
TEST_DB_HOST=localhost
TEST_DB_USER=root
TEST_DB_PASS=123456
TEST_DB_NAME=radius
