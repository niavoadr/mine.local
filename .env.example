DB_HOST=localhost
DB_PORT=[port_de_la_base_de_données]
DB_USER=[nom_d'utilisateur]
DB_PASS=[mot_de_passe]
DB_NAME=[nom_de_la_base_de_données]
RADIUS_MAC_SECRET=[mot secret pour le protocole RADIUS]

# --- Configuration pfSense (déconnexion immédiate portail captif) ---
# IP/host de l'interface d'administration pfSense
PFSENSE_HOST=192.168.1.1
# Port d'admin pfSense (défaut 443 en HTTPS, 80 en HTTP)
PFSENSE_PORT=443
# Mettre à true (défaut) pour HTTPS, false si pfSense n'écoute qu'en HTTP
PFSENSE_USE_HTTPS=true
# Identifiants admin pfSense (utilisés pour l'API XML-RPC native)
PFSENSE_USER=admin
PFSENSE_PASS=[mot_de_passe_admin_pfsense]
# Laisser à false si le certificat SSL de pfSense est auto-signé (défaut)
PFSENSE_VERIFY_SSL=false
# Laisser vide pour cibler toutes les zones du portail captif, sinon indiquer le nom de la zone (ex: cpzone1)
PFSENSE_CP_ZONE=
